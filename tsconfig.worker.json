{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/worker",
    "lib": ["ESNext", "webworker"],
    "types": [],
    "sourceMap": true,  // Enable source maps for easier debugging
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "declaration": false,
    "importHelpers": true
  },
  "include": [
    "app/**/*.worker.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
